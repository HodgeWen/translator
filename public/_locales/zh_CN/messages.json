  "desc_aggregate_enabled": {
    "message": "将多个段落合并为一个翻译请求，提高效率。"
  },
  "desc_color_scheme": {
    "message": "控制设置页与弹窗的明暗外观，不影响网页翻译结果。"
  },
  "desc_custom_tones": {
    "message": "定义属于你个人的翻译语气风格，与系统内置语气一同可选。"
  },
  "desc_enable_polysemy": {
    "message": "仅对弹窗短文本生效。输入为单词或短语时，额外给出词性、多义项对比与音标释义；网页翻译不会启用，避免污染页面结构。"
  },
  "desc_global_override_style": {
    "message": "忽略服务内单独指定的样式，强制所有服务统一使用选中样式。"
  },
  "desc_global_override_tone": {
    "message": "覆盖服务内指定的语气，统一使用选中的风格语气。"
  },
  "desc_global_prompt": {
    "message": "该提示词用于所有服务商，除非被单独覆盖。"
  },
  "desc_load_balance": {
    "message": "开启后，翻译请求将按权重自动分配到多个服务商，均衡使用配额。在 Popup 面板中可快速切换。"
  },
  "desc_model_fallback": {
    "message": "首选模型响应失败时，尝试该服务商的其余模型作为备份。"
  },
  "desc_prompt_mode_append": {
    "message": "留空则仅使用全局翻译提示词；填写后将追加到全局提示词之后，作为该服务的额外翻译指令。"
  },
  "desc_prompt_mode_override": {
    "message": "留空则使用全局翻译提示词；填写后将完全替换全局提示词，仅使用此处内容作为该服务的系统提示词。"
  },
  "desc_request_settings": {
    "message": "适用于所有翻译请求（包括聚合和非聚合翻译）。"
  },
  "desc_services_config": {
    "message": "配置 Single（单服务商）或 Pool（翻译池）组合，作为主要的翻译通道。"
  },
  "desc_use_service_default_style": {
    "message": "由各服务「高级配置」中单独指定的展示样式决定。"
  },
  "desc_use_service_default_tone": {
    "message": "由当前所选翻译服务的「高级配置」指定语气。"
  },
